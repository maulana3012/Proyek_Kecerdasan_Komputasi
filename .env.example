# APP SETTINGS
APP_NAME=FaceRecognitionApp
ENV=development

# MYSQL CONFIGURATION
MYSQL_HOST=masukan nama container database
MYSQL_PORT=masukan port container database
MYSQL_DATABASE=masukan nama database
MYSQL_USER=masukan username database
MYSQL_PASSWORD=masukan password database
MYSQL_ROOT_PASSWORD=masukan password root database

# REDIS CONFIGURATION
REDIS_HOST=redis_service
REDIS_PORT=6379

# ELASTICSEARCH CONFIGURATION
ELASTICSEARCH_HOST=http://elasticsearch_service:9200

# FASTAPI CONFIGURATION
FASTAPI_PORT=8000

# LARAVEL CONFIGURATION
LARAVEL_PORT=8080